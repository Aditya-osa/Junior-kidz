  white-space: normal;
  word-break: break-word;
  margin-bottom: 10px;
  line-height: 140%;
}
.choose-us-box-4 .content p {
  font-size: 14px;
  line-height: 160%;
}
.choose-us-box-4:hover::after {
  width: 100%;
  height: 100%;
  visibility: visible;
  opacity: 1;
}
.choose-us-box-4:hover::before {
  width: 100%;
  height: 100%;
  visibility: visible;
  opacity: 1;
  transform: initial;
  transform-origin: initial;
}

