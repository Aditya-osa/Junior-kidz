.event-list-wrapper .event-button {
  margin-top: 70px;
  text-align: center;
}
.event-list-wrapper .event-button .theme-btn {
  background-color: var(--theme-blue);
  color: var(--white);
}

.event-details-wrapper {
  margin-top: 0;
  position: relative;
  z-index: 9;
}
.event-details-wrapper .event-details-items .details-image {
  margin-bottom: 40px;
}
.event-details-wrapper .event-details-items .details-image img {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}
.event-details-wrapper .event-details-items .event-details-content h3 {
  font-size: 27px;
  margin-bottom: 20px;
}
.event-details-wrapper .event-details-items .event-details-content .details-list {
  margin-top: 25px;
  margin-bottom: 50px;
}
.event-details-wrapper .event-details-items .event-details-content .details-list li {
  font-weight: 500;
  font-size: 16px;
  color: var(--header);
}
.event-details-wrapper .event-details-items .event-details-content .details-list li:not(:last-child) {
  margin-bottom: 10px;
}
.event-details-wrapper .event-details-items .event-details-content .details-list li i {
  color: var(--theme-blue);
  margin-right: 10px;
}
.event-details-wrapper .event-details-items .event-details-content .map-area {
  margin-top: 40px;
  margin-bottom: 30px;
}
.event-details-wrapper .event-details-items .event-details-content .map-area iframe {
  height: 500px;
  width: 100%;
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items {
  margin-top: 40px;
  border: 1px solid var(--border);
  padding: 40px 45px;
  text-align: center;
  margin-right: -2px;
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items.border-right-none {
  border-right: none;
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items .event-content {
  margin-top: 25px;
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items .event-content h4 a {
  color: var(--header);
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items .event-content span {
  font-size: 14px;
  font-weight: 400;
  display: inline-block;
  margin-top: 5px;
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items .event-content .social-icon {
  margin-top: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  position: relative;
  z-index: 9;
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items .event-content .social-icon a {
  width: 35px;
  height: 35px;
  line-height: 35px;
  border-radius: 100px;
  text-align: center;
  font-size: 16px;
  display: block;
  color: #5B6D84;
  transition: all 0.4s ease-in-out;
  text-align: center;
  background-color: transparent;
  border: 1px solid var(--border);
}
.event-details-wrapper .event-details-items .event-details-content .event-image-items .event-content .social-icon a:hover {
  background-color: var(--theme-blue);
  color: var(--white);
  border: 1px solid transparent;
}
.event-details-wrapper .event-details-information {
  background-color: var(--white);
  padding: 40px 35px;
  box-shadow: 10px 4px 60px rgba(200, 200, 200, 0.25);
  border-radius: 7px;
}
.event-details-wrapper .event-details-information .information-list {
  margin-top: 20px;
  margin-bottom: 30px;
}
.event-details-wrapper .event-details-information .information-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 0;
  border-bottom: 1px solid var(--border);
}
.event-details-wrapper .event-details-information .information-list li span {
  font-size: 16px;
  color: var(--text);
  font-weight: 400;
}
.event-details-wrapper .event-details-information .information-list li span i {
  margin-right: 10px;
}
.event-details-wrapper .event-details-information .information-list li .text {
  font-weight: 500;
  color: var(--header);
  text-align: right;
  display: inline-block;
}
.event-details-wrapper .event-details-information .information-list li .text.color-2 {
  color: #F24721;
}
.event-details-wrapper .event-details-information .information-list li .text.color-3 {
  color: var(--theme-blue);
}
.event-details-wrapper .event-details-information .theme-btn {
  width: 100%;
  background-color: var(--theme-blue);
  color: var(--white);
  justify-content: center;
}
.event-details-wrapper .event-details-information .theme-btn::before, .event-details-wrapper .event-details-information .theme-btn::after {
  display: none;
}
.event-details-wrapper .event-details-information .theme-btn:hover {
  background-color: var(--header);
}
.event-details-wrapper .event-details-information .coming-soon-timer {
  display: flex;
  align-items: center;
  gap: 30px;
  max-width: 650px;
  justify-content: center;
  margin: 30px auto;
}
@media (max-width: 1199px) {
  .event-details-wrapper .event-details-information .coming-soon-timer {
    flex-wrap: wrap;
  }
}
.event-details-wrapper .event-details-information .coming-soon-timer .timer-content h3 {
  font-size: 27px;
  color: var(--header);
  width: 70px;
  height: 70px;
  line-height: 70px;
  border-radius: 50%;
  display: inline-block;
  background-color: #FFD335;
  text-align: center;
  font-family: Sora;
}
.event-details-wrapper .event-details-information .coming-soon-timer .timer-content h3.bg-2 span {
  background-color: #C3F499;
}
.event-details-wrapper .event-details-information .coming-soon-timer .timer-content h3.bg-3 span {
  background-color: #00E2C5;
}
.event-details-wrapper .event-details-information .coming-soon-timer .timer-content h3.bg-4 span {
  background-color: #66FFFF;
}
.event-details-wrapper .event-details-information .coming-soon-timer .timer-content p {
  font-weight: 500;
  font-size: 16px;
  margin-top: 10px;
  text-align: center;
}
.event-details-wrapper .event-details-information .share-btn {
  font-size: 18px;
  font-weight: 500;
  color: var(--theme-blue);
  display: inline-block;
}
.event-details-wrapper .event-details-information .share-btn i {
  margin-right: 5px;
}


/* --- [main.css: Popular Program Section] --- */
.popular-courses-section-33 .nav .nav-item .nav-link.active {
  background-color: var(--theme-red);
  color: var(--white);
}

.popular-program-section {
  background-color: var(--bg6);

  border-radius: 20px;
  position: relative;
}
@media (max-width: 1600px) {
  .popular-program-section {
    border-radius: 0;
    margin: 0;
  }
}
.popular-program-section .frame-shape {
  position: absolute;
  bottom: 80px;
  left: 60px;
  animation: rounded 5s linear infinite;
}
.popular-program-section .star-shape {
  position: absolute;
  top: 118px;
  right: 102px;
}

.popular-program-box-items {
  background-color: var(--white);
  border-radius: 20px;
  margin-top: 30px;
  position: relative;
}
.popular-program-section .section-title p {
  margin: 12px auto 0;
  max-width: 620px;
  color: var(--text);
}
.student-kit-card {
  height: 100%;
  margin-top: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20px;
  border: 1.5px solid rgba(13, 27, 62, 0.08);
  box-shadow: 0 10px 30px rgba(13, 27, 62, 0.05);
  overflow: hidden;
  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
}
.student-kit-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 45px rgba(13, 27, 62, 0.12);
  border-color: #F27D52;
}
.student-kit-card .thumb {
  height: 230px;
  mask: none;
  -webkit-mask: none;
  background: #ffffff;
  border-radius: 20px 20px 0 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 18px 6px;
}
.student-kit-card .thumb img {
  width: 100%;
  height: 100%;
  max-height: 205px;
  object-fit: contain;
  object-position: center bottom;
  padding: 0;
  border-radius: 0;
  display: block;
  margin: 0 auto;
  transition: transform 0.4s ease;
}
.student-kit-card:hover .thumb img {
  transform: scale(1.05);
}
.student-kit-card .content {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82px;
  padding: 16px 20px 24px;
  text-align: center;
  background: #ffffff;
}
.student-kit-card .content h3 {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: #0D1B3E;
  line-height: 1.35;
}
.popular-program-box-items .thumb {
  mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 263"><path fill-rule="evenodd" clip-rule="evenodd" d="M356.5 218C439.619 218 507 150.619 507 67.5C507 -15.6189 439.619 -83 356.5 -83C312.832 -83 273.508 -64.4021 246.016 -34.6949C235.853 -36.8604 225.309 -38 214.5 -38C194.328 -38 175.083 -34.0314 157.503 -26.8325C131.903 -46.9806 99.6053 -59 64.5 -59C-18.6189 -59 -86 8.38114 -86 91.5C-86 174.619 -18.6189 242 64.5 242C84.6719 242 103.917 238.031 121.497 230.832C147.097 250.981 179.395 263 214.5 263C258.168 263 297.492 244.402 324.984 214.695C335.147 216.86 345.691 218 356.5 218Z" /></svg>');
  mask-repeat: no-repeat;
  mask-position: center center;
  mask-size: cover;
  padding: 5px;
  padding-bottom: 0;
}
.popular-program-box-items .thumb img {
  width: 100%;
  height: 100%;
  border-radius: 20px;
}
.popular-program-box-items .content {
  padding: 30px 40px;
  position: relative;
  z-index: 9;
}
.popular-program-box-items .content .price {
  top: 40px;
  right: 40px;
  font-size: 35px;
  color: var(--theme-pink);
  position: absolute;
}
.popular-program-box-items .content .star {
  font-size: 14px;
  color: #FD8F21;
  margin-bottom: 15px;
}
.popular-program-box-items .content .star span {
  color: var(--header);
}
.popular-program-box-items .content h3 {
  margin-bottom: 15px;
}
.popular-program-box-items .content h3 a:hover {
  color: var(--theme-orange);
}
.popular-program-box-items .content .list {
  display: flex;
  align-items: center;
  gap: 25px;
  margin-top: 10px;
  margin-bottom: 30px;
}
@media (max-width: 1399px) {
  .popular-program-box-items .content .list {
    flex-wrap: wrap;
    gap: 20px;
  }
}
.popular-program-box-items .content .list li {
  color: var(--header);
  font-size: 14px;
}
.popular-program-box-items .content .list li i {
  color: var(--text);
  margin-right: 5px;
}
.popular-program-box-items .content .theme-btn {
  width: 100%;
  font-size: 14px;
  font-weight: 600;
  background-color: #F8F2EC;
  border-radius: 8px;
  border: 1px solid rgba(16, 47, 37, 0.1);
  text-align: center;
  justify-content: center;
  padding: 18px 30px;
}
.popular-program-box-items .content .theme-btn::before, .popular-program-box-items .content .theme-btn::after {
  background-color: var(--theme-orange);
}
.popular-program-box-items::before {
  position: absolute;
  content: "";
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-top: 1px solid var(--theme-orange);
  border-left: 1px solid var(--theme-orange);
  transition: 0.5s;
  opacity: 0;
  visibility: hidden;
  transform: initial;
  border-radius: 20px;
}
.popular-program-box-items::after {
  position: absolute;
  content: "";
  bottom: 0;
  right: 0;
  width: 0;
  height: 0;
  border-bottom: 1px solid var(--theme-orange);
  border-right: 1px solid var(--theme-orange);
  transition: 0.5s;
  opacity: 0;
  visibility: hidden;
  border-radius: 20px;
}
.popular-program-box-items:hover::after {
  width: 100%;
  height: 100%;
  visibility: visible;
  opacity: 1;
}
.popular-program-box-items:hover::before {
  width: 100%;
  height: 100%;
  visibility: visible;
  opacity: 1;
  transform: initial;
  transform-origin: initial;
}

/* --- [style.css: Hero Section 4 Responsive Styles across 10 Device Resolutions] --- */
/* =========================================================
   Hero Section 4 (Responsive across all 10 device resolutions:
   320px, 390px, 430px, 768px, 1024px, 1280px, 1366px, 1536px, 1920px, 3440px)
   ========================================================= */
.hero-section.hero-4 {
    height: auto;
    min-height: clamp(680px, 75vh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-top: clamp(85px, 11vh, 140px);
    padding-bottom: clamp(320px, 34vh, 380px);
    padding-left: 0;
    padding-right: 0;
    background-image:
        linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
        url("../img/image.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
}

.hero-4 .hero-content {
    max-width: 860px;
    width: 100%;
    margin: 0 auto;
    margin-top: clamp(12px, 2vh, 35px) !important;
    text-align: center;
    position: relative;
    z-index: 5;
}

.hero-4 .hero-content .wow {
    visibility: visible !important;
}

.hero-4 .hero-content h1 {
    font-size: clamp(36px, 4.2vw, 68px);
    line-height: 1.22;
    color: var(--white);
    margin-top: 18px;
    margin-bottom: 18px;
    text-transform: none;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6), 0 1px 3px rgba(0, 0, 0, 0.8);
    word-wrap: break-word;
}

.hero-4 .hero-content p {
    font-size: clamp(16px, 1.35vw, 21px);
    font-weight: 500;
    line-height: 1.65;
    color: var(--white);
    max-width: 720px;
    margin: 0 auto;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
    word-wrap: break-word;
}

.hero-4 .hero-content .hero-button {
    margin-top: 32px;
}

/* Tablets (768px - 991px) */
@media (max-width: 991px) {
    .hero-section.hero-4 {
        min-height: clamp(620px, 70vh, 760px);
        padding-top: clamp(80px, 10vh, 105px);
        padding-bottom: clamp(280px, 28vh, 320px);
    }
    .hero-4 .hero-content {
        margin-top: 15px !important;
    }
    .hero-4 .hero-content h1 {
        font-size: clamp(32px, 5.2vw, 46px);
        line-height: 1.25;
        margin-top: 16px;
        margin-bottom: 16px;
    }
}

/* Mobile (up to 767px: 320px, 390px, 430px) */
@media (max-width: 767px) {
    .hero-section.hero-4 {
        min-height: clamp(560px, 75vh, 660px);
        padding-top: 75px;
        padding-bottom: 270px;
        background-position: 58% center;
    }
    .hero-4 .container-fluid {
        padding-left: 15px !important;
        padding-right: 15px !important;
    }
    .hero-4 .hero-content {
        margin-top: 8px !important;
        padding: 0 8px;
    }
    .hero-4 .hero-content h1 {
        font-size: clamp(26px, 7.2vw, 34px);
        line-height: 1.26;
        margin-top: 14px;
        margin-bottom: 14px;
    }
    .hero-4 .hero-content p {
        font-size: clamp(14px, 3.8vw, 16px);
        line-height: 1.5;
        padding: 0 6px;
    }
}

/* Smallest Mobile (<= 360px: 320px screen) */
@media (max-width: 360px) {
    .hero-section.hero-4 {
        min-height: 560px;
        padding-top: 65px;
        padding-bottom: 270px;
    }
    .hero-4 .container-fluid {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }
    .hero-4 .hero-content {
        margin-top: 4px !important;
        padding: 0 4px;
    }
    .hero-4 .hero-content h1 {
        font-size: 24px;
        line-height: 1.25;
        margin-top: 10px;
        margin-bottom: 10px;
    }
    .hero-4 .hero-content p {
        font-size: 13.5px;
        line-height: 1.45;
        padding: 0 2px;
    }
    .hero-4 .hero-content .kidz-eyebrow {
        font-size: 15px !important;
        gap: 5px !important;
    }
    .hero-4 .hero-content .kidz-eyebrow::before,
    .hero-4 .hero-content .kidz-eyebrow::after {
        width: 16px !important;
        height: 13px !important;
    }
}

@import url("https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700;800&family=Quicksand:wght@500;600;700&family=Sora:wght@400;500;600;700;800&display=swap");


/* --- [style.css: Our Events Background & Welcome Junior Kidz Know More] --- */

/* Our Events Background */
.event-wrapper-2 .event-right-items,
.event-secton-2 .event-right-items {
    background-color: #009FE3 !important;
}

/* Welcome Junior Kidz - Know More Button */
.welcome-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #E52421 !important;
    color: #FFFFFF !important;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 32px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(229, 36, 33, 0.35);
    transition: all 0.3s ease;
}
.welcome-pill-btn:hover {
    background-color: #C01B18 !important;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(229, 36, 33, 0.45);
}

/* Spacing between Welcome eyebrow and paragraph */
.welcome-header,
.welcome-junior-section .welcome-header {
    margin-bottom: 55px !important;
}

@media (max-width: 991px) {
    .welcome-header,
    .welcome-junior-section .welcome-header {
        margin-bottom: 40px !important;
    }
}

@media (max-width: 767px) {
    .welcome-header,
    .welcome-junior-section .welcome-header {
        margin-bottom: 32px !important;
    }
}


/* --- [style.css: Event List Item & Home Events Ticker] --- */

/* Event List Item (Home page): Date box and title in 1 row on mobile/tablet (keep date size intact) */
@media (max-width: 1399px) {
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content {
        flex-wrap: nowrap !important;
        align-items: center !important;
        gap: 16px !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content .date {
        flex-shrink: 0 !important;
        padding: 12px 20px 12px !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content .date h2 {
        font-size: 40px !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content .title-text {
        flex: 1 1 auto !important;
        min-width: 0 !important;
        max-width: 100% !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content .title-text .post-time {
        margin-top: 10px !important;
        padding-top: 10px !important;
        flex-wrap: nowrap !important;
    }
}

@media (max-width: 575px) {
    .event-wrapper-2 .event-right-items .event-list-items {
        padding: 20px 15px !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content {
        gap: 12px !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content .title-text h4 {
        font-size: 16px !important;
        line-height: 1.35 !important;
    }
    .event-wrapper-2 .event-right-items .event-list-items .event-content .content .title-text .post-time {
        margin-top: 8px !important;
        padding-top: 8px !important;
        font-size: 13px !important;
    }
}

/* Home page events ticker: hardware acceleration & smooth pause on hover (prevents animation-transform conflict & hover jitter) */
.event-wrapper-2 .event-right-items .event-list-items {
    will-change: transform;
}
.event-wrapper-2 .event-right-items .event-list-area:hover .event-list-items,
.event-wrapper-2 .event-right-items .event-list-items:hover {
    animation-play-state: paused !important;
}
