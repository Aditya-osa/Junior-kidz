                        <div class="col-lg-4">
                            <div class="event-details-information sticky-style">
                                <div class="franchise-enroll-box">
                                    <h4>Why Enroll?</h4>
                                    <ul class="information-list">
                                        <li>
                                            <a href="#franchise-international">
                                                <i class="fas fa-handshake"></i>
                                                Franchise with Junior Kidz International
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#academics">
                                                <i class="fas fa-graduation-cap"></i>
                                                Our Academics
