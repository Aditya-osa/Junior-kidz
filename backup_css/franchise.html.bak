        <style>
            /* Franchise Program Horizontal Card Layout */
            .franchise-cards-container {
                display: flex;
                flex-direction: column;
                gap: 28px;
                margin-top: 32px;
                margin-bottom: 32px;
            }

            .franchise-section-card {
                display: flex;
                flex-direction: row;
                height: 310px;
                background: #ffffff;
                border: 1px solid #edf2f7;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 4px 18px rgba(13, 27, 62, 0.05);
                transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
                scroll-margin-top: 110px;
            }

            .franchise-section-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 28px rgba(13, 27, 62, 0.09);
                border-color: #cbd5e1;
            }

            .franchise-card-image {
                width: 38%;
                height: 100%;
                flex-shrink: 0;
                position: relative;
                overflow: hidden;
                background: #f1f5f9;
            }

            .franchise-card-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.35s ease;
            }

            .franchise-section-card:hover .franchise-card-image img {
                transform: scale(1.03);
            }

            .franchise-card-content {
                width: 62%;
                height: 100%;
                padding: 24px 28px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .franchise-card-title {
                font-size: 22px;
                font-weight: 700;
                color: #0c1e33;
                margin-bottom: 4px;
                line-height: 1.3;
            }

            .franchise-card-subtitle {
                font-size: 13px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: #e52421;
                margin-bottom: 12px;
                display: inline-block;
            }

            .franchise-card-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .franchise-card-list li {
                font-size: 14px;
                line-height: 1.45;
                color: #4b5563;
                display: flex;
                align-items: flex-start;
                gap: 10px;
            }

            .franchise-card-list li i {
                color: #10b981;
                font-size: 15px;
                margin-top: 3px;
                flex-shrink: 0;
            }

            /* Contact Details inside Contact Us Card */
            .franchise-contact-details {
                display: flex;
                flex-direction: column;
                gap: 7px;
                margin-bottom: 12px;
            }

            .franchise-contact-item {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                font-size: 13.5px;
                color: #4b5563;
                line-height: 1.4;
            }

            .franchise-contact-item i {
                color: #e52421;
                font-size: 14px;
                margin-top: 3px;
                flex-shrink: 0;
            }

            .franchise-contact-item a {
                color: #0c1e33;
                font-weight: 600;
                transition: color 0.2s ease;
            }

            .franchise-contact-item a:hover {
                color: #e52421;
            }

            .franchise-contact-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                align-self: flex-start;
                padding: 7px 18px;
                background: #e52421;
                color: #ffffff;
                font-size: 13px;
                font-weight: 600;
                border-radius: 8px;
                text-decoration: none;
                transition: background 0.2s ease, transform 0.2s ease;
                box-shadow: 0 4px 12px rgba(229, 36, 33, 0.22);
            }

            .franchise-contact-btn:hover {
                background: #c81e1b;
                color: #ffffff;
                transform: translateY(-2px);
            }

            /* Intro & Banner cards */
            .franchise-intro-card {
                background: #ffffff;
                border: 1px solid #edf2f7;
                border-radius: 16px;
                box-shadow: 0 4px 18px rgba(13, 27, 62, 0.05);
                padding: 26px 30px;
                margin-bottom: 28px;
                scroll-margin-top: 110px;
            }

            .franchise-intro-card h3 {
                font-size: 22px;
                font-weight: 700;
                color: #0c1e33;
                margin-bottom: 4px;
            }

            .franchise-why-enroll-banner {
                background: linear-gradient(135deg, #0c1e33 0%, #1e3a8a 100%);
                border-radius: 16px;
                padding: 28px 30px;
                color: #ffffff;
                margin-top: 28px;
            }

            .franchise-why-enroll-banner h3 {
                color: #ffffff;
                font-size: 22px;
                margin-bottom: 8px;
            }

            .franchise-why-enroll-banner p {
                color: #e2e8f0;
                margin: 0;
                font-size: 15px;
                line-height: 1.6;
            }

            .franchise-why-enroll-banner a {
                color: #38bdf8;
                font-weight: 600;
                text-decoration: underline;
            }

            .franchise-map-card {
                border-radius: 16px;
                overflow: hidden;
                border: 1px solid #edf2f7;
                box-shadow: 0 4px 18px rgba(13, 27, 62, 0.05);
                margin-top: 28px;
                height: 320px;
            }

            .franchise-map-card iframe {
                width: 100%;
                height: 100%;
                border: 0;
            }

            @media (max-width: 991px) {
                .franchise-section-card {
                    flex-direction: column;
                    height: auto;
                }
                .franchise-card-image {
                    width: 100%;
                    height: 220px;
                }
                .franchise-card-content {
                    width: 100%;
                    height: auto;
                    padding: 22px 20px;
                }
            }
        </style>
    </head>

