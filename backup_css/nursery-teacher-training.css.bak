/*
 * Nursery Teacher Training Page CSS
 * Includes: NTT Hero, Benefits Section, Curriculum Cards, Benefit Cards
 */

/* --- [style.css: Nursery Teacher Training Sections & Cards] --- */
/* =========================================================
   Faster Incoming & Entrance Animations on Mobile & Tablet
   ========================================================= */
@media (max-width: 991px) {
    /* Fast, snappy entrance animations for WOW.js & Animate.css */
    .wow,
    .animated {
        -webkit-animation-duration: 0.5s !important;
        animation-duration: 0.5s !important;
    }

    /* Shorten scroll entrance delays so items appear immediately */
    [data-wow-delay],
    .wow[style*="animation-delay"],
    .animated[style*="animation-delay"] {
        -webkit-animation-delay: 0.1s !important;
        animation-delay: 0.1s !important;
    }

    /* Faster image incoming reveal animations */
    .img-custom-anim-left,
    .img-custom-anim-right,
    .img-custom-anim-top,
    .img-custom-anim-bottom {
        animation-duration: 0.55s !important;
        animation-delay: 0.08s !important;
    }

    /* Snappy offcanvas mobile menu drawer slide-in */
    .offcanvas__info {
        transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    opacity 0.28s ease-in-out,
                    visibility 0.28s ease-in-out !important;
    }

    /* Livelier floating banner shapes */
    .banner-floating-shape.shape-flower {
        animation-duration: 2.8s !important;
    }
    .banner-floating-shape.shape-umbrella {
        animation-duration: 3.0s !important;
    }
    .banner-floating-shape.shape-balloon {
        animation-duration: 2.6s !important;
    }
    .banner-floating-shape.shape-tree {
        animation-duration: 3.0s !important;
    }
}

@media (max-width: 575px) {
    /* Extra fast & responsive entrance on mobile phones */
    .wow,
    .animated {
        -webkit-animation-duration: 0.4s !important;
        animation-duration: 0.4s !important;
    }

    [data-wow-delay],
    .wow[style*="animation-delay"],
    .animated[style*="animation-delay"] {
        -webkit-animation-delay: 0.05s !important;
        animation-delay: 0.05s !important;
    }
}
