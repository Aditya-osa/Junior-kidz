  font-size: clamp(32px, 3.2vw, 50px);
}

/* --- [About Wrapper 3 - Junior Kidz Hero Circle] --- */
.about-wrapper-3 .about-content {
  max-width: 770px;
}
.about-wrapper-3 .about-content .about-items {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-top: 50px;
}
@media (max-width: 767px) {
  .about-wrapper-3 .about-content .about-items {
    flex-wrap: wrap;
    gap: 28px;
    text-align: center;
    justify-content: center;
    margin-top: 32px;
  }
}
.about-wrapper-3 .about-content .about-items .circle-text {
  position: relative;
  flex-shrink: 0;
}
.about-wrapper-3 .about-content .about-items .circle-text .icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.about-wrapper-3 .about-content .about-items .circle-text .circle-animation {
  animation: cir36 10s linear infinite;
}
.about-wrapper-3 .about-content .about-items .content {
  max-width: 420px;
  width: 100%;
}
.about-wrapper-3 .about-content .about-items .content p,
.about-wrapper-3 .about-content .about-items .content P {
  margin-bottom: 40px;
}
@media (max-width: 575px) {
  .about-wrapper-3 .about-content .about-items .content p,
  .about-wrapper-3 .about-content .about-items .content P {
    margin-bottom: 24px;
  }
}

.about-wrapper-3 .hero-image {
  text-align: center;
  position: relative;
}
.about-wrapper-3 .hero-image .junior-kidz-circle {
  width: clamp(230px, 65vw, 340px);
  max-width: 90%;
  aspect-ratio: 1;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  animation: junior-kidz-bounce 2.8s ease-in-out infinite;
}
.about-wrapper-3 .hero-image .junior-kidz-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

@keyframes junior-kidz-bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-18px);
  }
}
@media (prefers-reduced-motion: reduce) {
  .about-wrapper-3 .hero-image .junior-kidz-circle {
    animation: none;
  }
}
@media (max-width: 991px) {
  .about-wrapper-3 .hero-image {
    margin-top: 30px;
  }
}
.about-wrapper-3 .hero-image .bg-shape {
  position: absolute;
  left: -18px;
  top: 50%;
  transform: translateY(-50%);
  z-index: -1;
  max-width: 100%;
}
@media (max-width: 991px) {
  .about-wrapper-3 .hero-image .bg-shape {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
}

/* --- [About Wrapper 4] --- */
.about-wrapper-4 {
  margin-bottom: 50px;
}
@media (max-width: 1399px) {
  .about-wrapper-4 {
    margin-bottom: 0;
  }
}
.about-wrapper-4 .about-image {
