/* --- [main.css: Popular Program Section] --- */
.popular-courses-section-33 .nav .nav-item .nav-link.active {
  background-color: var(--theme-red);
  color: var(--white);
}

.popular-program-section {
  background-color: var(--bg6);

  border-radius: 20px;
  position: relative;
}
@media (max-width: 1600px) {
  .popular-program-section {
    border-radius: 0;
    margin: 0;
  }
}
.popular-program-section .frame-shape {
  position: absolute;
  bottom: 80px;
  left: 60px;
  animation: rounded 5s linear infinite;
}
.popular-program-section .star-shape {
  position: absolute;
  top: 118px;
  right: 102px;
}

.popular-program-box-items {
  background-color: var(--white);
  border-radius: 20px;
  margin-top: 30px;
  position: relative;
}
.popular-program-section .section-title p {
  margin: 12px auto 0;
  max-width: 620px;
  color: var(--text);
}
.student-kit-card {
  height: 100%;
  margin-top: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20px;
  border: 1.5px solid rgba(13, 27, 62, 0.08);
  box-shadow: 0 10px 30px rgba(13, 27, 62, 0.05);
  overflow: hidden;
  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
}
.student-kit-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 45px rgba(13, 27, 62, 0.12);
  border-color: #F27D52;
}
.student-kit-card .thumb {
  height: 230px;
  mask: none;
  -webkit-mask: none;
  background: #ffffff;
  border-radius: 20px 20px 0 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 18px 6px;
}
.student-kit-card .thumb img {
  width: 100%;
  height: 100%;
  max-height: 205px;
  object-fit: contain;
  object-position: center bottom;
  padding: 0;
  border-radius: 0;
  display: block;
  margin: 0 auto;
  transition: transform 0.4s ease;
}
.student-kit-card:hover .thumb img {
  transform: scale(1.05);
}
.student-kit-card .content {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82px;
  padding: 16px 20px 24px;
  text-align: center;
  background: #ffffff;
}
.student-kit-card .content h3 {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: #0D1B3E;
  line-height: 1.35;
}
.popular-program-box-items .thumb {
  mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 263"><path fill-rule="evenodd" clip-rule="evenodd" d="M356.5 218C439.619 218 507 150.619 507 67.5C507 -15.6189 439.619 -83 356.5 -83C312.832 -83 273.508 -64.4021 246.016 -34.6949C235.853 -36.8604 225.309 -38 214.5 -38C194.328 -38 175.083 -34.0314 157.503 -26.8325C131.903 -46.9806 99.6053 -59 64.5 -59C-18.6189 -59 -86 8.38114 -86 91.5C-86 174.619 -18.6189 242 64.5 242C84.6719 242 103.917 238.031 121.497 230.832C147.097 250.981 179.395 263 214.5 263C258.168 263 297.492 244.402 324.984 214.695C335.147 216.86 345.691 218 356.5 218Z" /></svg>');
  mask-repeat: no-repeat;
  mask-position: center center;
  mask-size: cover;
  padding: 5px;
  padding-bottom: 0;
}
.popular-program-box-items .thumb img {
  width: 100%;
  height: 100%;
  border-radius: 20px;
}
.popular-program-box-items .content {
  padding: 30px 40px;
  position: relative;
  z-index: 9;
}
.popular-program-box-items .content .price {
  top: 40px;
  right: 40px;
  font-size: 35px;
  color: var(--theme-pink);
  position: absolute;
}
.popular-program-box-items .content .star {
  font-size: 14px;
  color: #FD8F21;
  margin-bottom: 15px;
}
.popular-program-box-items .content .star span {
  color: var(--header);
}
.popular-program-box-items .content h3 {
  margin-bottom: 15px;
}
.popular-program-box-items .content h3 a:hover {
  color: var(--theme-orange);
}
.popular-program-box-items .content .list {
  display: flex;
  align-items: center;
  gap: 25px;
  margin-top: 10px;
  margin-bottom: 30px;
}
@media (max-width: 1399px) {
  .popular-program-box-items .content .list {
    flex-wrap: wrap;
    gap: 20px;
  }
}
.popular-program-box-items .content .list li {
  color: var(--header);
  font-size: 14px;
}
.popular-program-box-items .content .list li i {
  color: var(--text);
  margin-right: 5px;
}
.popular-program-box-items .content .theme-btn {
  width: 100%;
  font-size: 14px;
  font-weight: 600;
  background-color: #F8F2EC;
  border-radius: 8px;
  border: 1px solid rgba(16, 47, 37, 0.1);
  text-align: center;
  justify-content: center;
  padding: 18px 30px;
}
.popular-program-box-items .content .theme-btn::before, .popular-program-box-items .content .theme-btn::after {
  background-color: var(--theme-orange);
}
.popular-program-box-items::before {
  position: absolute;
  content: "";
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-top: 1px solid var(--theme-orange);
  border-left: 1px solid var(--theme-orange);
  transition: 0.5s;
  opacity: 0;
  visibility: hidden;
  transform: initial;
  border-radius: 20px;
}
.popular-program-box-items::after {
  position: absolute;
  content: "";
  bottom: 0;
  right: 0;
  width: 0;
  height: 0;
  border-bottom: 1px solid var(--theme-orange);
  border-right: 1px solid var(--theme-orange);
  transition: 0.5s;
  opacity: 0;
  visibility: hidden;
  border-radius: 20px;
}
.popular-program-box-items:hover::after {
  width: 100%;
  height: 100%;
  visibility: visible;
  opacity: 1;
}
.popular-program-box-items:hover::before {
  width: 100%;
  height: 100%;
  visibility: visible;
  opacity: 1;
  transform: initial;
  transform-origin: initial;
}

/* --- [style.css: Welcome Junior Kidz Know More & Spacing] --- */
/* Welcome Junior Kidz - Know More Button */
.welcome-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #E52421 !important;
    color: #FFFFFF !important;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 32px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(229, 36, 33, 0.35);
    transition: all 0.3s ease;
}
.welcome-pill-btn:hover {
    background-color: #C01B18 !important;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(229, 36, 33, 0.45);
}

/* Spacing between Welcome eyebrow and paragraph */
.welcome-header,
.welcome-junior-section .welcome-header {
    margin-bottom: 55px !important;
}

@media (max-width: 991px) {
    .welcome-header,
    .welcome-junior-section .welcome-header {
        margin-bottom: 40px !important;
    }
}

@media (max-width: 767px) {
    .welcome-header,
    .welcome-junior-section .welcome-header {
        margin-bottom: 32px !important;
    }
}

/*
- About Us Page CSS - About Page Specific Styles (Fully Responsive: 320px to 3440px)
- Includes: About Sections, Mission, Vision, Core Values, Facilities, Popular Programs, Testimonials
- Preserves exact desktop & mobile layout structure while fixing overflow & scaling across all 10 target viewports.
*/

/* --- [Global Overflow & Ultrawide Safeguards] --- */
.about-wrapper,
.about-wrapper-2,
.about-wrapper-3,
.about-wrapper-4,
.about-wrapper-5,
.top-category-section-2,
.faq-section-5,
.popular-program-section {
  overflow-x: clip;
}

@media (min-width: 1921px) {
  .popular-program-section,
  .faq-section-5,
  .about-section-3 {
    max-width: 2400px;
    margin-left: auto;
    margin-right: auto;
  }
}

/* --- [main.css: About Wrapper] --- */
@media (max-width: 991px) {
  .about-wrapper {
    margin-top: -29px;
  }
}
@media (max-width: 767px) {
  .about-wrapper {
    margin-top: -60px;
  }
}
@media (max-width: 390px) {
  .about-wrapper {
    margin-top: -30px;
  }
}

.about-wrapper .about-image {
  margin-left: 0%;
  max-width: 585px;
  margin-top: 80px;
}
@media (max-width: 1199px) {
  .about-wrapper .about-image {
    margin-top: 0;
  }
}
@media (max-width: 991px) {
  .about-wrapper .about-image {
    max-width: 100%;
  }
}
.about-wrapper .about-image img {
  width: 100%;
  height: auto;
  display: block;
}

.about-wrapper .about-content {
  max-width: 700px;
  margin-top: 37px;
  position: relative;
  z-index: 9;
}
@media (max-width: 1199px) {
  .about-wrapper .about-content {
    margin-top: 0;
  }
}
@media (max-width: 767px) {
  .about-wrapper .about-content {
    margin-left: 10px;
    margin-right: 10px;
    text-align: center;
  }
}
@media (max-width: 390px) {
  .about-wrapper .about-content {
    margin-left: 0;
    margin-right: 0;
  }
}

.about-wrapper .about-content p {
  font-size: clamp(15px, 1.3vw, 20px);
  color: var(--header);
  line-height: 175%;
}
@media (max-width: 767px) {
  .about-wrapper .about-content p {
    text-align: center;
  }
}

.about-wrapper .about-content .counter-box-items {
  margin-top: 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 50px;
}
@media (max-width: 1199px) {
  .about-wrapper .about-content .counter-box-items {
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 30px;
    margin-bottom: 30px;
  }
}
@media (max-width: 767px) {
  .about-wrapper .about-content .counter-box-items {
    justify-content: center;
  }
}

.about-wrapper .about-content .counter-box-items .counter-content {
  border-right: 1px solid var(--border);
  padding-right: 150px;
}
@media (max-width: 1399px) {
  .about-wrapper .about-content .counter-box-items .counter-content {
    padding-right: 40px;
  }
}
@media (max-width: 1199px) {
  .about-wrapper .about-content .counter-box-items .counter-content {
    padding-right: 0;
    border-right: none;
  }
}
.about-wrapper .about-content .counter-box-items .counter-content h2 {
  font-size: clamp(40px, 5vw, 85px);
}
.about-wrapper .about-content .counter-box-items .counter-content p {
  font-size: clamp(15px, 1.2vw, 18px);
  color: var(--text);
}
.about-wrapper .about-content .counter-box-items .text {
  max-width: 270px;
  width: 100%;
  color: var(--text);
  font-size: 16px;
}

.about-wrapper .about-content .theme-btn {
  background-color: transparent;
  color: var(--header);
  border: 1px solid var(--header);
}
.about-wrapper .about-content .theme-btn::before,
.about-wrapper .about-content .theme-btn::after {
  background-color: var(--theme-green);
}

.about-wrapper .about-image-items {
  position: relative;
  margin-right: -10px;
  text-align: right;
}
@media (max-width: 1199px) {
  .about-wrapper .about-image-items {
    margin-right: 0;
    text-align: left;
  }
}
.about-wrapper .about-image-items .about-image-2 img {
  border-radius: 7px;
  object-fit: cover;
  max-width: 100%;
}
@media (max-width: 1199px) {
  .about-wrapper .about-image-items .about-image-2 img {
    width: 100%;
    height: auto;
  }
}
@media (max-width: 767px) {
  .about-wrapper .about-image-items .about-image-2 img {
    height: clamp(320px, 75vw, 550px);
  }
}

.about-wrapper .about-image-items .about-image-3 {
  position: absolute;
  bottom: -100px;
  left: -60px;
}
@media (max-width: 1399px) {
  .about-wrapper .about-image-items .about-image-3 {
    left: -20px;
    bottom: -60px;
  }
}
@media (max-width: 1199px) {
  .about-wrapper .about-image-items .about-image-3 {
    bottom: 0;
    left: 0;
    height: clamp(180px, 35vw, 300px);
    max-width: 65%;
  }
}
.about-wrapper .about-image-items .about-image-3 img {
  width: 100%;
  height: 100%;
  border-radius: 7px;
  object-fit: cover;
}

/* --- [About Section 3 & Wrapper 2] --- */
.about-section-3 {
  background-color: #09224B;
}

@media (max-width: 767px) {
  .about-wrapper-2 .about-content {
    text-align: center;
  }
}
.about-wrapper-2 .about-content p {
  font-size: clamp(15px, 1.3vw, 20px);
  color: var(--white);
  margin-bottom: 40px;
}
@media (max-width: 575px) {
  .about-wrapper-2 .about-content p {
    margin-bottom: 28px;
  }
}
.about-wrapper-2 .about-content .theme-btn {
  padding: 18px 30px;
}
@media (max-width: 390px) {
  .about-wrapper-2 .about-content .theme-btn {
    padding: 14px 22px;
    font-size: 14px;
  }
}
.about-wrapper-2 .about-content .theme-btn::before,
.about-wrapper-2 .about-content .theme-btn::after {
  background-color: var(--white);
}
.about-wrapper-2 .about-content .theme-btn:hover {
  color: var(--header);
}

.about-wrapper-2 .about-content .about-counter-items {
  margin-top: 50px;
  display: flex;
  align-items: center;
  gap: 70px;
}
@media (max-width: 1399px) {
  .about-wrapper-2 .about-content .about-counter-items {
    gap: 40px;
  }
}
@media (max-width: 1199px) {
  .about-wrapper-2 .about-content .about-counter-items {
    flex-wrap: wrap;
    gap: 28px;
  }
}
@media (max-width: 767px) {
  .about-wrapper-2 .about-content .about-counter-items {
    justify-content: center;
    align-items: center;
  }
}

.about-wrapper-2 .about-content .about-counter-items .counter-content:not(:last-child) {
  border-right: 1px solid var(--white);
  padding-right: 70px;
}
@media (max-width: 1399px) {
  .about-wrapper-2 .about-content .about-counter-items .counter-content:not(:last-child) {
    padding-right: 40px;
  }
}
@media (max-width: 1199px) {
  .about-wrapper-2 .about-content .about-counter-items .counter-content:not(:last-child) {
    border-right: none;
    padding-right: 0;
  }
}
.about-wrapper-2 .about-content .about-counter-items .counter-content h3 {
  font-size: clamp(36px, 3.6vw, 55px);
  font-weight: 500;
  color: var(--white);
}
.about-wrapper-2 .about-content .about-counter-items .counter-content p {
  font-size: clamp(15px, 1.2vw, 18px);
  margin-bottom: 0;
  color: var(--white);
}

.about-wrapper-2 .about-image {
  position: relative;
  z-index: 1;
}
.about-wrapper-2 .about-image img {
  max-width: 100%;
  height: auto;
}
@media (max-width: 1199px) {
  .about-wrapper-2 .about-image img {
    width: 100%;
    height: auto;
  }
}
@media (max-width: 991px) {
  .about-wrapper-2 .about-image img {
    width: auto;
    max-width: 100%;
  }
}
@media (max-width: 575px) {
  .about-wrapper-2 .about-image img {
    width: 100%;
  }
}

.about-wrapper-2 .about-image .bg-shape {
  position: absolute;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: -1;
  max-width: 100%;
}
@media (max-width: 1199px) {
  .about-wrapper-2 .about-image .bg-shape {
    display: none;
  }
}
@media (max-width: 991px) {
  .about-wrapper-2 .about-image .bg-shape {
    display: block;
  }
}
@media (max-width: 575px) {
  .about-wrapper-2 .about-image .bg-shape {
    display: none;
  }
}

.about-wrapper-2 .about-image .counter-box {
  background-color: var(--white);
  z-index: 9;
  position: absolute;
  bottom: 50px;
  right: -50px;
  padding: 30px 40px;
  border-radius: 10px;
}
@media (max-width: 1399px) {
  .about-wrapper-2 .about-image .counter-box {
    right: 0;
  }
}
@media (max-width: 575px) {
  .about-wrapper-2 .about-image .counter-box {
